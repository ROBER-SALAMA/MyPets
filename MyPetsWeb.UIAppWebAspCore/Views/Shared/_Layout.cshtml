<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyPetsWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/MyPetsWeb.UIAppWebAspCore.styles.css" asp-append-version="true" />
</head>
<body id="body-pd">
    <header class="header" id="header">
        <div class="header_toggle">
            <i class="bx bx-menu" id="header-toggle"></i>
        </div>
        <div class="header_img"><img src="/perrito kawai.png" alt="" /></div>
    </header>
    <div class="l-navbar" id="nav-bar">
        <nav class="nav">
            <div>
                <a href="#" class="nav_logo">
                    <i class="bx bx-layer nav_logo-icon"></i>
                    <span class="nav_logo-name">My Pets</span>
                </a>
                <div class="nav_list">
                    <a asp-area="" asp-controller="Home" class="nav_link active text-light"
                       asp-action="Index">
                        <i class="bx bx-grid-alt nav_icon"></i>
                        <span class="nav_name">Home</span>
                    </a>
                    <a asp-area="" asp-controller="Usuario" class="nav_link text-light"
                       asp-action="Index">
                        <i class="bx bx-user nav_icon"></i>
                        <span class="nav_name">Usuarios</span>
                    </a>
                    <a asp-area="" asp-controller="Rol" class="nav_link active text-light"
                       asp-action="Index">
                        <i class='bx bx-user-check bx-sm'></i>
                        <span class="nav_name">Roles</span>
                    </a>
                    <a asp-area="" asp-controller="Cita" class="nav_link text-light"
                       asp-action="Index">
                        <i class="bx bx-message-square-detail nav_icon"></i>
                        <span class="nav_name">Citas</span>
                    </a>
                    <a asp-area="" asp-controller="Mascota" class="nav_link text-light">
                        <i class='bx bxs-dog nav_icon'></i>
                        <span class="nav_name">Mascotas</span>
                    </a>
                    <a asp-area="" asp-controller="Servicio" class="nav_link text-light">
                        <i class="bx bx-folder nav_icon"></i>
                        <span class="nav_name">Servicios</span>
                    </a>
                    <a asp-area="" asp-controller="Veterinario" class="nav_link text-light">
                        <i class='bx bxs-shield-plus'></i>
                        <span class="nav_name">Veterinarios</span>
                    </a>
                </div>
            </div>
            <a href="#" class="nav_link">
                <i class="bx bx-log-out nav_icon"></i>
                <span class="nav_name">SignOut</span>
            </a>
        </nav>
    </div>
    <br />
    <br />
    <br />
    <div class="">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    
</body>
</html>
